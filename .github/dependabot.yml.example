version: 2
updates:
  # npm, yarn: JavaScript/Node.js packages
  - package-ecosystem: "npm"
    directory: "/"
    schedule:
      interval: "weekly"

  # pip, poetry: Python packages
  - package-ecosystem: "pip"
    directory: "/"
    schedule:
      interval: "weekly"

  # Maven: Java packages
  - package-ecosystem: "maven"
    directory: "/"
    schedule:
      interval: "weekly"

  # Gradle: Java packages
  - package-ecosystem: "gradle"
    directory: "/"
    schedule:
      interval: "weekly"

  # Go modules
  - package-ecosystem: "gomod"
    directory: "/"
    schedule:
      interval: "weekly"

  # Ruby gems
  - package-ecosystem: "bundler"
    directory: "/"
    schedule:
      interval: "weekly"

  # Cargo: Rust packages
  - package-ecosystem: "cargo"
    directory: "/"
    schedule:
      interval: "weekly"

  # NuGet: .NET packages
  - package-ecosystem: "nuget"
    directory: "/"
    schedule:
      interval: "weekly"

  # Composer: PHP packages
  - package-ecosystem: "composer"
    directory: "/"
    schedule:
      interval: "weekly"

  # Terraform modules
  - package-ecosystem: "terraform"
    directory: "/"
    schedule:
      interval: "weekly"

  # pub: Dart/Flutter packages
  - package-ecosystem: "pub"
    directory: "/"
    schedule:
      interval: "weekly"

  # Helm charts
  - package-ecosystem: "helm"
    directory: "/"
    schedule:
      interval: "weekly"
